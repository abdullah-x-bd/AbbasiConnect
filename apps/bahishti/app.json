{
  "expo": {
    "name": "ABC Bahishti Connections",
    "slug": "abc-bahishti",
    "scheme": "abcbahishti",
    "version": "1.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.abbasiconnect.bahishti",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/abc-emblem.png",
        "backgroundColor": "#FAECD5"
      }
    },
    "ios": {
      "bundleIdentifier": "org.abbasiconnect.bahishti",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ABC to select an optional profile photo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ABC Bahishti Connections to record voice answers for transcription.",
          "enableBackgroundRecording": false
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "appName": "Abbasi Bahishti Connections"
    },
    "icon": "./assets/abc-emblem.png",
    "splash": {
      "image": "./assets/abc-emblem.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAECD5"
    },
    "androidStatusBar": {
      "backgroundColor": "#FAECD5",
      "barStyle": "dark-content"
    }
  }
}
