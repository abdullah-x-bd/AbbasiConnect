{
  "expo": {
    "name": "ABC Bahishti Connections",
    "slug": "abc-bahishti",
    "scheme": "abcbahishti",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.abbasiconnect.bahishti",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.abbasiconnect.bahishti",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ABC to select an optional profile photo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ABC Bahishti Connections to record voice answers for transcription.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "extra": {
      "appName": "Abbasi Bahishti Connections"
    }
  }
}
