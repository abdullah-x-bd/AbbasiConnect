generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  ANNULLED
  SEPARATED
}

enum FamilyRelation {
  PARENT
  CHILD
  SIBLING
  SPOUSE
  OTHER
}

enum FamilyLinkStatus {
  INVITED
  VERIFIED
  DECLINED
}

enum AccessStatus {
  PENDING
  APPROVED
  DECLINED
  REVOKED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  FALSE_INFORMATION
  INAPPROPRIATE
  OTHER
}

model User {
  id              String    @id @default(uuid())
  displayName     String    @db.VarChar(80)
  username        String    @unique @db.VarChar(24)
  passwordHash    String?
  email           String?   @unique @db.VarChar(254)
  phone           String?   @unique @db.VarChar(20)
  contactVerified Boolean   @default(false)
  verificationChannel String? @db.VarChar(24)

  identityRefHash String?   @unique
  identityLast4   String?
  identityName    String?   @db.VarChar(100)
  aadhaarVerifiedAt DateTime?

  dateOfBirth     DateTime?
  gender          String?   @db.VarChar(32)
  city            String?   @db.VarChar(80)
  state           String?   @db.VarChar(80)
  country         String    @default("India") @db.VarChar(80)
  heightCm        Int?
  maritalStatus   MaritalStatus?
  education       String    @default("") @db.VarChar(180)
  occupation      String    @default("") @db.VarChar(180)
  about           String    @default("") @db.VarChar(1500)
  languages       String    @default("") @db.VarChar(300)
  interests       String    @default("") @db.VarChar(500)
  profileImageData String?   @db.Text

  profileCreatedBy String   @default("SELF") @db.VarChar(32)
  familyDetails   String    @default("") @db.VarChar(1200)
  preferredMinAge      Int?
  preferredMaxAge      Int?
  preferredMinHeightCm Int?
  preferredMaxHeightCm Int?
  preferredLocations   String @default("") @db.VarChar(400)
  preferredEducation   String @default("") @db.VarChar(300)
  preferredOccupation  String @default("") @db.VarChar(300)
  partnerNotes         String @default("") @db.VarChar(1200)

  // Public key plus a password-wrapped private key backup for browser E2EE.
  // The server never receives the unencrypted private key.
  e2eePublicKey          String? @db.Text
  e2eeEncryptedPrivateKey String? @db.Text
  e2eeKeySalt            String? @db.VarChar(128)
  e2eeKeyIv              String? @db.VarChar(128)
  e2eeKeyVersion         Int     @default(1)

  isProfileActive   Boolean  @default(true)
  isDirectoryVisible Boolean @default(true)
  role              UserRole @default(MEMBER)
  verifiedAt        DateTime @default(now())
  suspendedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  otpChallenges       OtpChallenge[]
  familyLinksCreated  FamilyLink[] @relation("familyOwner")
  familyLinksClaimed  FamilyLink[] @relation("familyRelative")
  treeRequestsSent    FamilyTreeAccess[] @relation("treeRequester")
  treeRequestsReceived FamilyTreeAccess[] @relation("treeTarget")
  rishteProfile       RishteProfile?
  interestsSent       MatchInterest[] @relation("interestSender")
  interestsReceived   MatchInterest[] @relation("interestReceiver")
  shortlistsMade      Shortlist[] @relation("shortlistOwner")
  shortlistedBy       Shortlist[] @relation("shortlistTarget")
  posts               Post[]
  postLikes           PostLike[]
  comments            PostComment[]
  threadOne           DirectThread[] @relation("threadUserOne")
  threadTwo           DirectThread[] @relation("threadUserTwo")
  messages            Message[]
  blocksMade          Block[] @relation("blocker")
  blocksReceived      Block[] @relation("blocked")
  reportsMade         Report[] @relation("reporter")
  reportsAgainst      Report[] @relation("reportedUser")
  reportsReviewed     Report[] @relation("reviewedBy")

  @@index([gender, isProfileActive, suspendedAt])
  @@index([city, state])
  @@index([dateOfBirth])
}

model OtpChallenge {
  id        String   @id @default(uuid())
  userId    String?
  contact   String   @db.VarChar(254)
  channel   String   @db.VarChar(24)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contact, createdAt])
}

model FamilyLink {
  id             String           @id @default(uuid())
  ownerId        String
  relativeUserId String?
  relativeName   String           @db.VarChar(100)
  relation       FamilyRelation
  relationLabel  String           @default("") @db.VarChar(80)
  inviteCode     String           @unique @db.VarChar(16)
  status         FamilyLinkStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner        User  @relation("familyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  relativeUser User? @relation("familyRelative", fields: [relativeUserId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([relativeUserId, status])
}

model FamilyTreeAccess {
  id          String       @id @default(uuid())
  requesterId String
  targetId    String
  status      AccessStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User @relation("treeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("treeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model RishteProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  isActive     Boolean  @default(false)
  headline     String   @default("") @db.VarChar(180)
  bio          String   @default("") @db.VarChar(1500)
  familyNote   String   @default("") @db.VarChar(1000)
  lookingFor   String   @default("") @db.VarChar(1000)
  contactRoute String   @default("THROUGH_APP") @db.VarChar(40)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, updatedAt])
}

model MatchInterest {
  id         String         @id @default(uuid())
  senderId   String
  receiverId String
  status     InterestStatus @default(PENDING)
  message    String         @default("") @db.VarChar(500)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   User @relation("interestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("interestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Shortlist {
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("shortlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("shortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([userId, targetId])
  @@index([targetId])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  body      String   @db.VarChar(2500)
  imageData String?   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]
  reports  Report[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model DirectThread {
  id        String   @id @default(uuid())
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOne User @relation("threadUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("threadUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  body      String   @default("") @db.VarChar(2000)
  encrypted Boolean  @default(false)
  ciphertext String? @db.Text
  iv         String? @db.VarChar(128)
  senderKey  String? @db.Text
  recipientKey String? @db.Text
  encryptionVersion Int?
  createdAt DateTime @default(now())
  readAt    DateTime?

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String?
  postId          String?
  reason         ReportReason
  details        String       @default("") @db.VarChar(1000)
  status         ReportStatus @default(OPEN)
  reviewedById   String?
  moderationNote String       @default("") @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User? @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  post         Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("reviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([postId])
}
