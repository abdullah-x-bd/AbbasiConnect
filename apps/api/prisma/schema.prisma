generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  ANNULLED
  SEPARATED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  FALSE_INFORMATION
  INAPPROPRIATE
  OTHER
}

model User {
  id              String    @id @default(uuid())
  identityRefHash String    @unique
  identityLast4   String?
  identityName    String?   @db.VarChar(100)

  displayName     String    @db.VarChar(80)
  username        String    @unique @db.VarChar(24)
  passwordHash    String?
  email           String?   @unique @db.VarChar(254)
  phone           String?   @unique @db.VarChar(20)
  dateOfBirth     DateTime?
  gender          String?   @db.VarChar(32)
  city            String?   @db.VarChar(80)
  state           String?   @db.VarChar(80)
  country         String    @default("India") @db.VarChar(80)

  heightCm        Int?
  maritalStatus   MaritalStatus?
  education       String    @default("") @db.VarChar(180)
  occupation      String    @default("") @db.VarChar(180)
  profileCreatedBy String   @default("SELF") @db.VarChar(32)
  about           String    @default("") @db.VarChar(1500)
  familyDetails   String    @default("") @db.VarChar(1200)
  languages       String    @default("") @db.VarChar(300)
  interests       String    @default("") @db.VarChar(500)

  preferredMinAge      Int?
  preferredMaxAge      Int?
  preferredMinHeightCm Int?
  preferredMaxHeightCm Int?
  preferredLocations   String @default("") @db.VarChar(400)
  preferredEducation   String @default("") @db.VarChar(300)
  preferredOccupation  String @default("") @db.VarChar(300)
  partnerNotes         String @default("") @db.VarChar(1200)

  isProfileActive Boolean   @default(true)
  role            UserRole  @default(MEMBER)
  verifiedAt      DateTime  @default(now())
  suspendedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  interestsSent     MatchInterest[] @relation("interestSender")
  interestsReceived MatchInterest[] @relation("interestReceiver")
  shortlistsMade    Shortlist[]     @relation("shortlistOwner")
  shortlistedBy     Shortlist[]     @relation("shortlistTarget")
  blocksMade        Block[]         @relation("blocker")
  blocksReceived    Block[]         @relation("blocked")
  reportsMade       Report[]        @relation("reporter")
  reportsAgainst    Report[]        @relation("reportedUser")
  reportsReviewed   Report[]        @relation("reviewedBy")

  @@index([gender, isProfileActive, suspendedAt])
  @@index([city, state])
  @@index([dateOfBirth])
}

model MatchInterest {
  id         String         @id @default(uuid())
  senderId   String
  receiverId String
  status     InterestStatus @default(PENDING)
  message    String         @default("") @db.VarChar(500)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   User @relation("interestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("interestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Shortlist {
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("shortlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("shortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([userId, targetId])
  @@index([targetId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         ReportReason
  details        String       @default("") @db.VarChar(1000)
  status         ReportStatus @default(OPEN)
  reviewedById   String?
  moderationNote String       @default("") @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("reviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
}
